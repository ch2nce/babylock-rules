 ],
 "textReplacements": [
  {
   "find": "\"adPlacements\"",
   "replace": "\"no_ads\"",
   "url": "/player"
  },
  {
   "find": "/\"adPlacements.*?([A-Z]\"\\}|\"\\}{2,4})\\}\\],/",
   "replace": "",
   "url": "playlist\\?list=|\\/player(?:\\?.+)?$|watch\\?[tv]="
  },
  {
   "find": "/\"adPlacements.*?(\"adSlots\"|\"adBreakHeartbeatParams\")/gms",
   "replace": "$1",
   "url": "\\/player(?:\\?.+)?$"
  },
  {
   "find": "\"adPlacements\"",
   "replace": "\"no_ads\"",
   "url": "player\\?"
  },
  {
   "find": "\"adSlots\"",
   "replace": "\"no_ads\"",
   "url": "player\\?"
  },
  {
   "find": "\"adSlots\"",
   "replace": "\"no_ads\"",
   "url": "^\\W+$"
  },
  {
   "find": "\"adSlots\"",
   "replace": "\"no_ads\"",
   "url": "/get_watch\\?"
  }
 ],
 "hideSelectors": [
